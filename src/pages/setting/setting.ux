<template>
  <div class="page">
    <list class="list">
      <!-- 字体大小 -->
      <list-item class="item" @click="openFontSize">
        <div class="item-content">
          <text class="itemtext">字体大小</text>
          <text class="itemtext2">{{fontSizeLabel}}</text>
        </div>
        <image src="/common/images/enter.png" static style="width:32dp;height:32dp;" />
      </list-item>

      <!-- 振动反馈 -->
      <list-item class="item" @click="toggleVibration">
        <div class="item-content">
          <text class="itemtext">振动反馈</text>
          <text class="itemtext2">新消息按键振动</text>
        </div>
        <image src="{{vibration ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" static
               style="width:32dp;height:24dp;" />
      </list-item>

      <!-- 屏幕常亮 -->
      <list-item class="item" @click="toggleKeepScreenOn">
        <div class="item-content">
          <text class="itemtext">屏幕常亮</text>
          <text class="itemtext2">聊天时保持亮屏</text>
        </div>
        <image src="{{keepScreenOn ? '/common/images/Switch_ON.png' : '/common/images/Switch_OFF.png'}}" static
               style="width:32dp;height:24dp;" />
      </list-item>

      <!-- 关于 -->
      <list-item class="item" @click="openAbout">
        <div class="item-content">
          <text class="itemtext">关于</text>
          <text class="itemtext2">版本 0.1.0</text>
        </div>
        <image src="/common/images/enter.png" static style="width:32dp;height:32dp;" />
      </list-item>

      <!-- 退出登录 -->
      <list-item class="item" @click="confirmLogout">
        <div class="item-content">
          <text class="itemtext">退出登录</text>
          <text class="itemtext2">登出手机端 Telegram</text>
        </div>
        <image src="/common/images/delete.png" static style="width:32dp;height:32dp;" />
      </list-item>
    </list>

    <!-- 顶部 header -->
    <image src="/common/images/hd.png" static
           style="position:absolute;left:0dp;top:0dp;width:212px;height:82dp;" />
    <text style="position:absolute;top:16dp;left:0dp;width:212px;text-align:center;font-size:18dp;color:rgba(255,255,255,0.6);">{{nowTime}}</text>
    <text static style="position:absolute;top:36dp;left:0dp;width:212px;text-align:center;font-size:26dp;font-weight:bold;color:#ffffff;">设置</text>
  </div>
</template>

<style>
.page {
  width: 212px;
  height: 480dp;
  background-color: #000000;
}
.list {
  width: 212px;
  position: absolute;
  top: 0dp;
  left: 0dp;
  padding: 86dp 12dp;
}
.item {
  width: 100%;
  height: 85dp;
  padding: 12dp 18dp;
  margin-bottom: 8dp;
  background-color: #262626;
  border-radius: 26dp;
  align-items: center;
  justify-content: space-between;
}
.item-content {
  height: 100%;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}
.itemtext {
  font-size: 23dp;
  width: 100%;
  font-weight: bold;
  color: #ffffff;
  text-overflow: ellipsis;
  lines: 1;
}
.itemtext2 {
  font-size: 18dp;
  font-weight: bold;
  color: rgba(255,255,255,0.6);
  text-overflow: ellipsis;
  lines: 1;
}
</style>

<script>
import store from '../../utils/store'
import api from '../../utils/api'
import { nowTimeString } from '../../utils/format'

export default {
  data: {
    nowTime: '',
    vibration: true,
    keepScreenOn: false,
    fontSizeLabel: '中'
  },

  onInit() {
    this.nowTime = nowTimeString()
    this.refreshFromStore()
  },

  onShow() {
    this.nowTime = nowTimeString()
    this.refreshFromStore()
  },

  refreshFromStore() {
    const settings = store.get('settings') || {}
    this.vibration = !!settings.vibration
    this.keepScreenOn = !!settings.keepScreenOn
    const scale = settings.fontScale || 1.0
    this.fontSizeLabel = scale < 0.95 ? '小' : (scale > 1.05 ? '大' : '中')
  },

  toggleVibration() {
    const settings = store.get('settings') || {}
    settings.vibration = !settings.vibration
    store.saveSettings()
    this.vibration = settings.vibration
    this.showToast(settings.vibration ? '振动已开启' : '振动已关闭')
  },

  async toggleKeepScreenOn() {
    const brightness = require('@system.brightness')
    const settings = store.get('settings') || {}
    settings.keepScreenOn = !settings.keepScreenOn
    try {
      brightness.setKeepScreenOn({ keepScreenOn: settings.keepScreenOn })
      store.saveSettings()
      this.keepScreenOn = settings.keepScreenOn
      this.showToast(settings.keepScreenOn ? '常亮已开启' : '常亮已关闭')
    } catch (e) {
      this.showToast('设置失败')
    }
  },

  openFontSize() {
    // 简化实现：循环切换 小→中→大→小
    const settings = store.get('settings') || {}
    const current = settings.fontScale || 1.0
    let next, label
    if (current < 0.95) { next = 1.0; label = '中' }
    else if (current > 1.05) { next = 0.9; label = '小' }
    else { next = 1.2; label = '大' }
    settings.fontScale = next
    store.saveSettings()
    this.fontSizeLabel = label
    this.showToast('字体：' + label)
  },

  openAbout() {
    this.showToast('TG Wear 0.1.0 | GPL v2')
  },

  confirmLogout() {
    // 简化实现：直接退出（后续可加 conform.png 弹窗确认页）
    const prompt = require('@system.prompt')
    prompt.showDialog({
      title: '退出登录',
      message: '确定要退出 Telegram 吗？',
      buttons: [
        { text: '取消', color: '#ffffff' },
        { text: '确定', color: '#2ea0ff' }
      ],
      success: (d) => {
        if (d.index === 1) {
          this.doLogout()
        }
      }
    })
  },

  async doLogout() {
    try {
      await api.logout()
    } catch (e) {
      console.warn('logout rpc failed', e)
    }
    store.clearSession()
    store.clearDialogs()
    const router = require('@system.router')
    router.replace({ uri: 'pages/splash' })
  },

  showToast(msg) {
    const prompt = require('@system.prompt')
    prompt.showToast({ message: msg, duration: 1500 })
  }
}
</script>
